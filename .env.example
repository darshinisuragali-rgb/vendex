# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1
REACT_APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendex_db
DB_USER=vendex_user
DB_PASSWORD=vendex_password
DB_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Azure Configuration
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=vendex-container

# Payment Integration
UPI_GATEWAY_KEY=your_upi_gateway_key
UPI_GATEWAY_SECRET=your_upi_gateway_secret

# Notification Service
SMS_PROVIDER_KEY=your_sms_provider_key
EMAIL_PROVIDER_KEY=your_email_provider_key

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ENABLED=true
CSRF_ENABLED=true
